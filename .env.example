# GEMINI_API_KEY: Required for server-side Gemini adapter health & model calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SQLite persistence path (default: ./data/ai-masterplan.db)
SQLITE_PATH="./data/ai-masterplan.db"

# Session signing secret (set a long random string in production)
SESSION_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"
SESSION_TTL_HOURS="24"

# Optional non-interactive initial administrator bootstrap (when users table is empty)
# BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
# BOOTSTRAP_ADMIN_PASSWORD="CHANGE_ME_MIN_10_CHARS"
# BOOTSTRAP_ADMIN_NAME="Primary Administrator"
